    "start:online": "set BROWSER=none&& expo start --lan --port 8088",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "expo start --android --port 8088",
    "ios": "expo start --ios --port 8088",
    "web": "expo start --web --port 8081",
    "lint": "expo lint"
  },

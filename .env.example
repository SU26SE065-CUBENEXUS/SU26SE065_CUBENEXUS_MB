# ============================================================
# CUBENEXUS MOBILE ENVIRONMENT CONFIG (.env.example / .env.local)
# ============================================================

# ------------------------------------------------------------
# [CHẾ ĐỘ 1: CHẠY LOCAL]
# ------------------------------------------------------------
# A. Khi chạy trên Web browser (npm run web) hoặc iOS Simulator:
EXPO_PUBLIC_API_BASE_URL=http://localhost:5212

# B. Khi chạy trên Android Emulator:
# (Android Emulator coi localhost của PC là 10.0.2.2)
# EXPO_PUBLIC_API_BASE_URL=http://10.0.2.2:5212

# C. Khi chạy trên Điện thoại thật (Expo Go qua Wi-Fi chung):
# (Thay 192.168.1.X bằng IP máy tính của bạn, gõ ipconfig trong PowerShell để xem IPv4)
# EXPO_PUBLIC_API_BASE_URL=http://192.168.1.X:5212

# ------------------------------------------------------------
# [CHẾ ĐỘ 2: CHẠY SERVER CHUNG CỦA NHÓM HOẶC DÙNG NGROK]
# (Cách tiện nhất khi test trên điện thoại thật hoặc dùng server chung)
# ------------------------------------------------------------
# EXPO_PUBLIC_API_BASE_URL=https://perfectly-detail-gory.ngrok-free.dev
